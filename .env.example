# Supabase ---------------------------------------------------------------
# URL e anon key sao publicas (vao pro bundle). A service role NUNCA vai:
# e ela que atravessa o RLS da tabela leads, e so pode existir server-side.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# E-mail -----------------------------------------------------------------
# MAIL_PROVIDER e a unica chave para trocar de provider. Se o DNS do Resend
# nao verificar a tempo, basta MAIL_PROVIDER=gmail, sem tocar em codigo.
MAIL_PROVIDER=resend
RESEND_API_KEY=
MAIL_FROM="Mel Simao | Storymaker <mel@melstorymaker.com.br>"
# Respostas dos leads caem no Gmail que a Mel ja usa no dia a dia.
MAIL_REPLY_TO=

# 1 = loga o e-mail no console em vez de enviar. Obrigatorio em desenvolvimento.
MAIL_DRY_RUN=1

# Contingencia: exige 2FA ativo na conta Google + App Password gerada.
GMAIL_USER=
GMAIL_APP_PASSWORD=

# App --------------------------------------------------------------------
# WhatsApp da Mel em formato internacional, so digitos. Ex: 5519999999999
MEL_WHATSAPP=
APP_URL=http://localhost:3000
