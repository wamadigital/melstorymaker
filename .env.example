# =============================================================================
# .env.example | Sistema de Propostas Mel Simao Storymaker
#
# Copie para .env.local e preencha. Depois rode: npm run infra:verificar
# =============================================================================

# --- SUPABASE ----------------------------------------------------------------
# Onde achar: dashboard do Supabase > seu projeto > Settings > API
#
# ATENCAO: a service role atravessa o RLS da tabela leads. Ela e o unico
# caminho de acesso aos leads e NUNCA pode chegar ao navegador.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- E-MAIL: remetente -------------------------------------------------------
# O envio e feito pelo Gmail da Mel, via SMTP. O volume nao justifica servico
# transacional: a conta Workspace entrega 2.000 destinatarios/dia.
#
# O Google REESCREVE o endereco do remetente para a conta autenticada, entao o
# endereco em MAIL_FROM precisa ser o mesmo de GMAIL_USER. O nome de exibicao
# ("Mel Simao | Storymaker") sobrevive, e e ele que a maioria dos leads ve.

MAIL_FROM="Mel Simão | Storymaker <mel@wama.digital>"
MAIL_REPLY_TO=

# --- E-MAIL: trava de seguranca ----------------------------------------------
# 1 = loga o e-mail no console em vez de enviar.
#
# DEIXE 1 EM DESENVOLVIMENTO. Com 0, um clique em "Enviar por e-mail" no painel
# manda a proposta de verdade pro endereco do lead. Na Vercel vai como 0.

MAIL_DRY_RUN=1

# --- E-MAIL: credenciais do Gmail --------------------------------------------
# A senha normal da conta NAO funciona no SMTP. Precisa de uma App Password de
# 16 caracteres, gerada em:
#   myaccount.google.com > Seguranca > Verificacao em duas etapas > Senhas de app
#
# Exige 2FA ativo. Em conta Workspace, o admin do dominio tambem precisa
# permitir App Passwords. Cole os 16 caracteres SEM espacos.

GMAIL_USER=
GMAIL_APP_PASSWORD=

# --- APP ---------------------------------------------------------------------
# MEL_WHATSAPP: numero da Mel em formato internacional, SO DIGITOS.
#   Ex: 5519999998888  (55 = Brasil, 19 = DDD, resto o numero)

MEL_WHATSAPP=
APP_URL=http://localhost:3000

# --- CRON ---------------------------------------------------------------------
# No plano gratuito o Supabase pausa o projeto apos 7 dias com pouca atividade
# de banco, e o formulario cai sozinho. A rota /api/cron/manter-ativo faz uma
# consulta por dia para evitar isso; a Vercel a chama mandando este segredo em
# "Authorization: Bearer ...". Sem ele a rota responde 503 (falha fechada).
#
# Gerar um valor: openssl rand -hex 32

CRON_SECRET=

# --- NOTIFICACAO: WhatsApp da Mel quando chega lead novo ---------------------
# Provider: CallMeBot (callmebot.com), gratuito. Ativacao (feita UMA vez, no
# celular que vai receber): adicionar o numero do bot (esta em
# callmebot.com/blog/free-api-whatsapp-messages/) aos contatos e mandar a
# mensagem "I allow callmebot to send me messages". O bot responde com a
# apikey. A Mel so RECEBE mensagens; nada e enviado do numero dela.
#
# Sem a APIKEY a notificacao simplesmente nao dispara (o formulario nao depende
# dela). NOTIFICA_DRY_RUN=1 loga em vez de enviar - deixe 1 em dev.
#
# NOTIFICA_WHATSAPP_FONE e OPCIONAL: sem ele o aviso vai para o MEL_WHATSAPP
# acima, que ja e o numero dela. Preencha so para mandar a notificacao para um
# aparelho diferente do numero publicado ao lead. ATENCAO: a apikey do CallMeBot
# e amarrada ao numero que fez a autorizacao -- se apontar para outro numero sem
# autorizar aquele, o gateway recusa.

NOTIFICA_WHATSAPP_FONE=
NOTIFICA_WHATSAPP_APIKEY=
NOTIFICA_DRY_RUN=1

# --- META PIXEL + CONVERSIONS API --------------------------------------------
# Onde achar: business.facebook.com > Gerenciador de Eventos > o Pixel (dataset).
#
# META_PIXEL_ID: o numero do Pixel. Liga o Pixel do navegador no /formulario
#   (PageView, Contact, Lead, SubmitApplication). Nunca entra no /admin.
# META_CAPI_TOKEN: Configuracoes do Pixel > Conversions API > "Gerar token de
#   acesso". Liga o lado servidor: copia de Lead/SubmitApplication (quem tem
#   bloqueador de anuncio continua contado) e os eventos do quadro
#   (PropostaEnviada, VirouCliente, LeadPerdido). SEGREDO: so servidor.
# META_CAPI_TEST_CODE: opcional. Com o codigo da aba "Testar eventos", os
#   eventos do servidor caem SO la, sem contar nas campanhas. Esvazie depois.
#
# DEIXE OS TRES VAZIOS EM DESENVOLVIMENTO: sem eles nada sai, e os e2e (que
# criam leads de verdade) nao sujam o Pixel de producao. Na Vercel, so em
# production -- preview tambem sujaria.

META_PIXEL_ID=
META_CAPI_TOKEN=
META_CAPI_TEST_CODE=

# --- CONTRATO: IA (Anthropic) ------------------------------------------------
# Onde achar: console.anthropic.com > Settings > API Keys.
#
# OPCIONAL. O contrato e montado por codigo (valores, extenso, parcelas,
# clausulas, numeracao) e sai sem a IA. A chave liga so tres ajudas no painel:
# "Preencher com IA" (separa os dados de quem assina de um texto colado),
# a clausula "Das condicoes especiais" (redigida a partir das observacoes da
# Mel) e a revisao que devolve avisos. Sem ela, os botoes ficam desabilitados
# e as observacoes viram um aviso para a Mel escrever a clausula no editor.
#
# A IA nunca recebe CPF, e-mail, telefone, endereco nem nome de quem assina:
# o contrato vai com marcadores ([CONTRATANTE], [HOMENAGEADO]). A excecao e o
# "Preencher com IA", que por natureza le o texto que a Mel colou.
# SEGREDO: so servidor.

ANTHROPIC_API_KEY=

# --- CONTRATO: assinatura eletronica (iLoveAPI / iLovePDF Sign) --------------
# Onde achar: developer.ilovepdf.com > Console > Projects > o projeto > API keys.
# ILOVEAPI_PUBLIC_KEY e a "project public key" (project_public_...); apesar do
# nome, e SEGREDO: e ela que gasta os creditos de assinatura da conta.
# ILOVEAPI_SECRET_KEY nao e usada hoje (o token vem de /v1/auth com a publica);
# preencha se um dia o projeto passar a assinar o JWT localmente.
#
# A conta precisa de CREDITOS DE ASSINATURA (pacote proprio, separado dos
# creditos de processamento). Sem eles o envio falha com recado no painel.

ILOVEAPI_PUBLIC_KEY=
ILOVEAPI_SECRET_KEY=

# --- CONTRATO: trava de seguranca da assinatura ------------------------------
# 1 = o envio para assinatura loga um resumo (sem nome nem e-mail) e NADA sai:
# nenhum e-mail com link de assinatura, nenhum credito gasto. Mesmo papel do
# MAIL_DRY_RUN.
#
# DEIXE 1 EM DESENVOLVIMENTO. Com 0 e a chave preenchida, "Enviar para
# assinatura" manda o contrato de verdade para o e-mail do cliente. Na Vercel
# vai como 0. O `npm run e2e:contrato` so exercita o envio com isto em 1.

ASSINATURA_DRY_RUN=1
