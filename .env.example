# =============================================================================
# .env.example | Sistema de Propostas Mel Simao Storymaker
#
# Copie para .env.local e preencha. Depois rode: npm run infra:verificar
# =============================================================================

# --- SUPABASE ----------------------------------------------------------------
# Onde achar: dashboard do Supabase > seu projeto > Settings > API
#
# ATENCAO: a service role atravessa o RLS da tabela leads. Ela e o unico
# caminho de acesso aos leads e NUNCA pode chegar ao navegador.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- E-MAIL: remetente -------------------------------------------------------
# O envio e feito pelo Gmail da Mel, via SMTP. O volume nao justifica servico
# transacional: a conta Workspace entrega 2.000 destinatarios/dia.
#
# O Google REESCREVE o endereco do remetente para a conta autenticada, entao o
# endereco em MAIL_FROM precisa ser o mesmo de GMAIL_USER. O nome de exibicao
# ("Mel Simao | Storymaker") sobrevive, e e ele que a maioria dos leads ve.

MAIL_FROM="Mel Simão | Storymaker <mel@wama.digital>"
MAIL_REPLY_TO=

# --- E-MAIL: trava de seguranca ----------------------------------------------
# 1 = loga o e-mail no console em vez de enviar.
#
# DEIXE 1 EM DESENVOLVIMENTO. Com 0, um clique em "Enviar por e-mail" no painel
# manda a proposta de verdade pro endereco do lead. Na Vercel vai como 0.

MAIL_DRY_RUN=1

# --- E-MAIL: credenciais do Gmail --------------------------------------------
# A senha normal da conta NAO funciona no SMTP. Precisa de uma App Password de
# 16 caracteres, gerada em:
#   myaccount.google.com > Seguranca > Verificacao em duas etapas > Senhas de app
#
# Exige 2FA ativo. Em conta Workspace, o admin do dominio tambem precisa
# permitir App Passwords. Cole os 16 caracteres SEM espacos.

GMAIL_USER=
GMAIL_APP_PASSWORD=

# --- APP ---------------------------------------------------------------------
# MEL_WHATSAPP: numero da Mel em formato internacional, SO DIGITOS.
#   Ex: 5519999998888  (55 = Brasil, 19 = DDD, resto o numero)

MEL_WHATSAPP=
APP_URL=http://localhost:3000

# --- CRON ---------------------------------------------------------------------
# No plano gratuito o Supabase pausa o projeto apos 7 dias com pouca atividade
# de banco, e o formulario cai sozinho. A rota /api/cron/manter-ativo faz uma
# consulta por dia para evitar isso; a Vercel a chama mandando este segredo em
# "Authorization: Bearer ...". Sem ele a rota responde 503 (falha fechada).
#
# Gerar um valor: openssl rand -hex 32

CRON_SECRET=

# --- NOTIFICACAO: WhatsApp da Mel quando chega lead novo ---------------------
# Provider: CallMeBot (callmebot.com), gratuito. Ativacao (feita UMA vez, no
# celular que vai receber): adicionar o numero do bot (esta em
# callmebot.com/blog/free-api-whatsapp-messages/) aos contatos e mandar a
# mensagem "I allow callmebot to send me messages". O bot responde com a
# apikey. A Mel so RECEBE mensagens; nada e enviado do numero dela.
#
# Sem a APIKEY a notificacao simplesmente nao dispara (o formulario nao depende
# dela). NOTIFICA_DRY_RUN=1 loga em vez de enviar - deixe 1 em dev.
#
# NOTIFICA_WHATSAPP_FONE e OPCIONAL: sem ele o aviso vai para o MEL_WHATSAPP
# acima, que ja e o numero dela. Preencha so para mandar a notificacao para um
# aparelho diferente do numero publicado ao lead. ATENCAO: a apikey do CallMeBot
# e amarrada ao numero que fez a autorizacao -- se apontar para outro numero sem
# autorizar aquele, o gateway recusa.

NOTIFICA_WHATSAPP_FONE=
NOTIFICA_WHATSAPP_APIKEY=
NOTIFICA_DRY_RUN=1
