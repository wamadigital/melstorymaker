{
  "name": "mel-storymaker",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "node --conditions=react-server --import tsx --test \"lib/**/*.test.ts\"",
    "templates:placeholder": "node scripts/placeholder-templates.mjs",
    "pdf:verificar": "node --conditions=react-server --import tsx scripts/verificar-pdf.ts",
    "infra:verificar": "node --env-file=.env.local --import tsx scripts/verificar-infra.ts",
    "admin:criar": "node --env-file=.env.local --import tsx scripts/criar-admin.ts",
    "e2e:formulario": "node --env-file=.env.local --import tsx scripts/e2e-formulario.ts",
    "e2e:admin": "node --env-file=.env.local --import tsx scripts/e2e-admin.ts",
    "e2e:quadro": "node --env-file=.env.local --import tsx scripts/e2e-quadro.ts",
    "e2e:arraste": "node --env-file=.env.local --import tsx scripts/e2e-arraste.ts",
    "bundle:verificar": "node --env-file=.env.local --import tsx scripts/verificar-bundle.ts",
    "arte:preparar": "node --conditions=react-server --import tsx scripts/preparar-arte.ts",
    "arte:derivar": "node --conditions=react-server --import tsx scripts/derivar-tabela.ts",
    "vercel:env": "bash scripts/vercel-env.sh",
    "estilo:verificar": "node scripts/verificar-estilo.mjs http://localhost:3000/formulario http://localhost:3000/admin/login",
    "screenshot": "node scripts/screenshot.mjs",
    "notifica:testar": "node --env-file=.env.local --import tsx scripts/testar-notificacao.ts"
  },
  "dependencies": {
